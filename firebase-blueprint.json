{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": ["string", "null"], "maxLength": 256 },
        "displayName": { "type": ["string", "null"], "maxLength": 128 },
        "photoURL": { "type": ["string", "null"], "maxLength": 1024 },
        "bio": { "type": "string", "maxLength": 1024 },
        "themeColor": { "type": "string", "maxLength": 64 },
        "bgGradient": { "type": "string", "maxLength": 256 },
        "preferences": {
          "type": "object",
          "properties": {
            "defaultServer": { "type": "string", "enum": ["ani", "mal", "vidsrc"] },
            "defaultAudio": { "type": "string", "enum": ["sub", "dub"] }
          }
        }
      },
      "required": ["uid", "preferences"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    }
  }
}

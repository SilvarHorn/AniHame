rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email == 'sounavasarkara@gmail.com'; 
    }

    // Global Safety Net
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // UserProfile Validation
    function isValidUserProfile(data) {
      let hasRequired = data.keys().hasAll(['uid', 'preferences']);
      let validUid = data.uid is string && data.uid.size() <= 128 && (data.uid == request.auth.uid || isAdmin());
      let validEmail = !('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256);
      let validDisplayName = !('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 128);
      let validPhotoURL = !('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1048576);
      let validBio = !('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 1024);
      let validThemeColor = !('themeColor' in data) || data.themeColor == null || (data.themeColor is string && data.themeColor.size() <= 64);
      let validBgGradient = !('bgGradient' in data) || data.bgGradient == null || (data.bgGradient is string && data.bgGradient.size() <= 256);
      
      let validPrefs = data.preferences is map 
        && (!('defaultServer' in data.preferences) || data.preferences.defaultServer in ['ani', 'mal', 'vidsrc'])
        && (!('defaultAudio' in data.preferences) || data.preferences.defaultAudio in ['sub', 'dub']);

      return hasRequired && validUid && validEmail && validDisplayName && validPhotoURL && validBio && validThemeColor && validBgGradient && validPrefs;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      
      allow create: if (isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())) || isAdmin();

      allow update: if (isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid) || isAdmin();
        
      allow delete: if isAdmin();
    }
  }
}
